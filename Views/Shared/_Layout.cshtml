@*
    Layout principal (`_Layout.cshtml`) para las páginas públicas de la aplicación.
    Este archivo, generado por defecto en un nuevo proyecto ASP.NET Core, define la
    estructura HTML común, incluyendo la barra de navegación superior (header), el pie de
    página (footer) y las referencias a los scripts y estilos CSS globales. Las vistas
    individuales se renderizan dentro de la sección `@RenderBody()`.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - AIRTProvisional</title>
    @* Marcador de posición para 'import maps', una característica moderna de JavaScript para gestionar módulos. Puede estar vacío si no se utiliza. *@
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/AIRTProvisional.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">AIRTProvisional</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @* Este es el marcador de posición principal donde se inyectará el contenido de las vistas individuales (ej. Index.cshtml, Privacy.cshtml). *@
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2025 - AIRTProvisional - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@*
    Marcador de posición para que las vistas individuales puedan inyectar sus propios scripts.
    `required: false` significa que las vistas no están obligadas a definir una sección "Scripts".
*@
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>