@*
    Plantilla de correo electrónico para notificar a un usuario que su cuenta ha sido eliminada.
    Este template se renderiza como el cuerpo de un correo electrónico y se envía al
    usuario afectado después de que un administrador ha eliminado su cuenta del sistema.
*@
@model ArandanoIRT.Web._3_Presentation.ViewModels.Emails.AccountDeletedViewModel
@{
    Layout = "_EmailLayout.cshtml"; // Define el layout base para correos electrónicos.
    ViewData["Title"] = "Confirmación de Cierre de Cuenta";
}

<h1>Notificación de Cierre de Cuenta</h1>

<p>Hola, @Model.UserName,</p>

<p>Le informamos que su cuenta en el sistema Arandano IRT ha sido eliminada por un administrador.</p>

<p>Esta acción es permanente y ya no podrá acceder al sistema con sus credenciales.</p>

<p>Si cree que esto es un error o tiene alguna pregunta, por favor, contacte al soporte del sistema.</p>

<p>Saludos cordiales,<br>El equipo de Arandano IRT</p>