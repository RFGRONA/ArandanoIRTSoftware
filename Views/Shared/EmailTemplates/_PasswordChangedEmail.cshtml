@*
    Plantilla de correo electrónico para confirmar un cambio de contraseña exitoso.
    Este correo se envía al usuario inmediatamente después de que ha completado
    el proceso de restablecimiento de contraseña. Sirve como una notificación
    de seguridad, permitiendo al usuario reaccionar rápidamente si el cambio
    no fue autorizado por él.
*@
@model string 
@{
    Layout = "_EmailLayout.cshtml"; // Define el layout base para correos electrónicos.
    ViewData["Title"] = "Confirmación de Cambio de Contraseña";
}

<h1>Contraseña Actualizada</h1>

<p>Hola, @Model,</p>

<p>Te confirmamos que la contraseña de tu cuenta en Arandano IRT ha sido cambiada exitosamente.</p>

@*
    Bloque de advertencia de seguridad. Es crucial para alertar al usuario
    de que debe tomar medidas inmediatas si no fue él quien realizó el cambio.
*@
<div style="background-color: #f8d7da; border-left: 4px solid #dc3545; padding: 16px; margin: 24px 0; border-radius: 8px;">
    <p style="color: #842029; font-weight: bold; margin: 0;">
        Si no realizaste este cambio, por favor, contacta a soporte inmediatamente o utiliza la opción de "Olvidé mi contraseña" para asegurar tu cuenta.
    </p>
</div>

<p>Gracias,<br>El equipo de Arandano IRT</p>