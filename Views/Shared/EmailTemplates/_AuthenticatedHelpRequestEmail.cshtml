@*
    Plantilla de correo electrónico para notificar a los administradores
    sobre una nueva solicitud de ayuda enviada por un usuario autenticado.
    Este correo resume toda la información de la solicitud, incluyendo los
    datos del usuario que la envió, para que el equipo de soporte pueda
    darle seguimiento.
*@
@using ArandanoIRT.Web._0_Domain.Entities
@model (ArandanoIRT.Web._1_Application.DTOs.Admin.AuthenticatedHelpRequestDto Request, User RequestingUser)
@{
    Layout = "_EmailLayout.cshtml"; // Define el layout base para correos electrónicos.
    ViewData["Title"] = "Nueva Solicitud de Ayuda (Usuario Registrado)";
}

<h1>Nueva Solicitud de Ayuda (Usuario Registrado)</h1>

<p>Se ha recibido una nueva solicitud de ayuda de un usuario autenticado con la siguiente información:</p>

@*
    Tabla que formatea y presenta de manera clara los detalles de la solicitud,
    incluyendo el asunto, los datos del usuario que la envió y el mensaje.
*@
<table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin: 24px 0; background-color: #f4f5f7; border-radius: 8px; padding: 20px;">
    <tr>
        <td>
            <p style="margin-bottom: 12px;"><strong>Asunto:</strong> @Model.Request.Subject</p>
            <hr style="border: none; border-top: 1px solid #dddddd; margin: 16px 0;">
            <p style="margin-bottom: 12px;"><strong>Nombre:</strong> @Model.RequestingUser.FirstName @Model.RequestingUser.LastName</p>
            <p style="margin-bottom: 12px;"><strong>Email:</strong> <a href="mailto:@Model.RequestingUser.Email">@Model.RequestingUser.Email</a></p>
            <p style="margin-bottom: 12px;"><strong>ID de Usuario:</strong> @Model.RequestingUser.Id</p>
            <hr style="border: none; border-top: 1px solid #dddddd; margin: 16px 0;">
            <p style="margin-bottom: 8px;"><strong>Mensaje:</strong></p>
            <p style="margin: 0;">@Model.Request.Message</p>
        </td>
    </tr>
</table>

<p>Por favor, revisa y responde a esta solicitud a la brevedad posible.</p>