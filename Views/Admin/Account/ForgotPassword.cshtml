@*
    Página de "Olvidé mi Contraseña".
    Permite al usuario solicitar un enlace de restablecimiento de contraseña 
    ingresando su correo electrónico. Incorpora Cloudflare Turnstile como medida
    de seguridad para prevenir el abuso automatizado.
*@

@model ArandanoIRT.Web._1_Application.DTOs.Admin.ForgotPasswordDto
@* Inyección de las configuraciones de Cloudflare Turnstile (SiteKey) desde appsettings.json. *@
@inject Microsoft.Extensions.Options.IOptions<ArandanoIRT.Web._2_Infrastructure.Settings.TurnstileSettings> TurnstileSettings
@* Inyección del entorno para mostrar contenido condicionalmente (ej. Development vs. Production). *@
@inject IWebHostEnvironment Env
@{
    Layout = null; @* Esta es una página independiente que no utiliza el layout principal. *@
    ViewData["Title"] = "Recuperar Contraseña";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Arandano IRT</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="~/css/forgotPassword.css" asp-append-version="true"/>

    @* Carga el script de Cloudflare Turnstile solo en entornos de no-desarrollo (ej. Staging, Production). *@
    @if (!Env.IsDevelopment())
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
</head>
<body>

<div class="auth-card">
    <div class="auth-header">
        <span class="emoji">🔑</span>
        <h1>¿Olvidaste tu Contraseña?</h1>
        <p class="text-muted mt-2">Introduce tu correo y te enviaremos un enlace para restablecerla.</p>
    </div>

    <form asp-action="ForgotPassword" method="post">
        @* Muestra un resumen de todos los errores de validación del modelo. *@
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>

        <div class="form-group mb-3">
            <label asp-for="Email" class="form-label">Correo Electrónico</label>
            <input asp-for="Email" class="form-control" placeholder="tu-correo@ejemplo.com"/>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-center">
            @* Contenedor donde se renderiza el widget de Cloudflare Turnstile. *@
            @* La 'data-sitekey' es la clave pública que identifica este sitio ante Cloudflare. *@
            <div class="cf-turnstile mb-3" data-sitekey="@TurnstileSettings.Value.SiteKey"></div>
        </div>

        <div class="action-buttons">
            <button type="submit" class="btn btn-primary w-100">Enviar Enlace de Recuperación</button>
            <a asp-action="Login" class="btn btn-secondary-outline w-100">Volver a Inicio de Sesión</a>
        </div>
    </form>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<partial name="_ValidationScriptsPartial" />

</body>
</html>