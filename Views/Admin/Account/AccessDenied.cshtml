@*
    Esta vista se muestra al usuario cuando intenta acceder a un recurso 
    para el cual está autenticado pero no tiene los permisos (rol) necesarios.
    Corresponde a un error de autorización (HTTP 403 Forbidden).
*@
@{
    ViewData["Title"] = "Acceso Denegado";
    Layout = "_LayoutAdminLogin";
}

<header>
    <h1 class="text-danger">@ViewData["Title"]</h1>
    <p class="text-danger">No tienes permiso para acceder a este recurso.</p>
</header>