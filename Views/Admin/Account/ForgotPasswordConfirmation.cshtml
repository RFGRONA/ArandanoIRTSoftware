@*
    Página de confirmación de "Olvidé mi Contraseña".
    Se muestra al usuario después de que ha solicitado con éxito un enlace
    de restablecimiento. Su propósito es informar que, si el correo proporcionado
    es válido, recibirá instrucciones para continuar el proceso.
*@
@{
    Layout = null; @* Es una página de notificación que no requiere el layout principal. *@
    ViewData["Title"] = "Revisa tu Correo";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Arandano IRT</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <link rel="stylesheet" href="~/css/ForgotPasswordConfirmation.css" asp-append-version="true"/>

</head>
<body>

<div class="auth-card">
    <div class="auth-header">
        <span class="emoji">📧</span>
        <h1>¡Revisa tu bandeja de entrada!</h1>
        <p class="text-muted mt-3 px-3">
            Si una cuenta con ese correo electrónico existe en nuestro sistema, hemos enviado un enlace para restablecer tu contraseña.
        </p>
    </div>

    <a asp-action="Login" class="btn btn-primary">Volver a Inicio de Sesión</a>
</div>

</body>
</html>