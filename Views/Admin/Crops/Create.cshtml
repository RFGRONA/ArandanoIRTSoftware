@*
    Página para la creación de un nuevo cultivo.
    Esta vista actúa como un contenedor o "host" para el formulario parcial
    _CropFormPartial, proporcionando el contexto de la acción "Crear" y
    cargando los scripts necesarios para su funcionamiento.
*@
@model ArandanoIRT.Web._1_Application.DTOs.Crops.CropCreateDto
@{
    ViewData["Title"] = "Crear Nuevo Cultivo";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/crud-forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* Failsafe para evitar el scroll horizontal en esta vista */
        body {
            overflow-x: hidden;
        }
    </style>
}

<div class="page-header">
    <h1>@ViewData["Title"]</h1>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <form asp-action="Create">
            <div class="card form-card">
                <div class="card-body">
                    @*
                        Se renderiza el formulario parcial, pasándole el modelo actual.
                        Esto permite reutilizar la misma estructura de formulario tanto para
                        la creación como para la edición de cultivos.
                    *@
                    <partial name="_CropFormPartial" model="Model" />
                </div>
                <div class="card-footer">
                    <a asp-action="Index" class="btn btn-secondary-outline">Cancelar</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Crear Cultivo
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    @*
        Carga el script `location-selector.js`, que es responsable de
        gestionar la lógica de los selectores anidados de departamento y ciudad
        presentes en el formulario parcial.
    *@
    <script src="~/js/location-selector.js" asp-append-version="true"></script>
}