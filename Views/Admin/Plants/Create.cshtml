@*
    Página para el registro de una nueva planta.
    Esta vista actúa como un "host" o contenedor para el formulario parcial
    reutilizable `_PlantFormPartial`, proporcionando el contexto de la acción "Crear"
    y los botones correspondientes del formulario.
*@
@model ArandanoIRT.Web._1_Application.DTOs.Plants.PlantCreateDto
@{
    ViewData["Title"] = "Registrar Nueva Planta";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/crud-forms.css" asp-append-version="true"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
}

<div class="page-header">
    <h1>@ViewData["Title"]</h1>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <form asp-action="Create">
            <div class="card form-card">
                <div class="card-body">
                    @*
                        Se renderiza el formulario parcial, que contiene todos los campos
                        comunes para crear y editar una planta.
                    *@
                    <partial name="_PlantFormPartial" model="Model"/>
                </div>
                <div class="card-footer">
                    <a asp-action="Index" class="btn btn-secondary-outline">Cancelar</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Registrar Planta
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @* Carga los scripts necesarios para la validación del lado del cliente. *@
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}